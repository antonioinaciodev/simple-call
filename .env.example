# Copie para .env e ajuste. Os valores abaixo batem com `livekit-server --dev`.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# URL que o NAVEGADOR usa para falar com o LiveKit (wss:// em produção).
LIVEKIT_URL=ws://localhost:7880
PORT=3001

# Protótipo P2P (opcional): TURN da Cloudflare pra quando a conexão direta falhar.
# Crie em dash.cloudflare.com → Realtime → TURN Server.
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
